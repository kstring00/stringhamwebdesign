# Copy to .env.local (gitignored) and fill in real values.
# Everything here is a secret or an account-specific id, except NEXT_PUBLIC_SITE_URL
# and PORTAL_URL. Never commit a filled-in copy.

# --- Supabase (required: portal, intake and the Stripe webhook all throw without both) ---
# Supabase dashboard > your project > Project Settings > Data API > "Project URL".
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard > Project Settings > API Keys > Secret keys > Reveal / create.
# The sb_secret_* key (formerly service_role). Server-only: it bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Stripe (test mode only) ---
# Stripe dashboard with the "Test mode" toggle ON > Developers > API keys >
# "Secret key". app/lib/stripe.ts requireTestKey() throws on anything that is
# not sk_test_ — sk_live_, restricted (rk_) and publishable (pk_) keys all fail.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Local runs: the whsec_* line printed by `stripe listen --forward-to ...`.
# Deployed: Stripe dashboard > Developers > Webhooks > endpoint > "Signing secret".
# Different values — do not reuse the deployed one locally.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Recurring price for the care plan subscription. Stripe dashboard (test mode) >
# Product catalogue > your care plan product > Pricing > the price's API id.
# Used as the fallback when /api/portal/admin/care-plan is called without a
# priceId; that route 400s if neither is present.
STRIPE_CARE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# --- Portal ---
# Optional. The email that gets bootstrapped as the portal admin on first
# magic-link sign-in. Code falls back to a hardcoded address in
# app/lib/portalSupabase.ts when unset.
PORTAL_ADMIN_EMAIL=

# Where a magic link sends people. Must ALSO be listed in Supabase under
# Authentication > URL Configuration > Redirect URLs, or Supabase silently
# refuses the redirect and the link lands on the site root.
#   local:      http://localhost:3000/portal
#   production: https://www.stringhamwebdesign.com/portal
# Falls back to NEXT_PUBLIC_SITE_URL + /portal, then to localhost. A production
# build with none of these set warns loudly at boot.
PORTAL_URL=http://localhost:3000/portal

# The site's own origin, used as the fallback base for PORTAL_URL above. Public:
# it is inlined into the client bundle, so never put anything secret here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend email notifications (all optional) ---
# With RESEND_API_KEY unset, /api/capture and /api/quote skip sending mail and
# everything else still works.
# resend.com/api-keys > "Create API Key".
RESEND_API_KEY=
# Recipient for inquiry notifications. Each route has its own hardcoded default.
CAPTURE_TO_EMAIL=
# Sender. Must be a resend.com/domains verified domain, or onboarding@resend.dev.
CAPTURE_FROM_EMAIL=

# Sender for portal notifications specifically (new message, new file, the
# ten-hour check-in). Falls back to CAPTURE_FROM_EMAIL, then to
# onboarding@resend.dev, which lands in spam until the domain is verified.
PORTAL_FROM_EMAIL=
# Test-only. Redirects portal notification mail to a local capture server so
# scripts/portal-notify-check.js can assert recipients without sending anything.
# app/lib/portalEmail.ts ignores this whenever NODE_ENV is production, so it
# cannot be used to divert real client mail on a deployed server.
PORTAL_MAIL_ENDPOINT=
