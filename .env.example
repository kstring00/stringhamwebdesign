# Copy to .env.local (gitignored) and fill in real values. Never commit a
# filled-in copy.

# --- Contact form email (Resend) ---
# With RESEND_API_KEY unset, /api/contact logs the message on the server and
# still shows the visitor a confirmation, so a missing key never loses a
# lead silently — but nothing is emailed.
# resend.com/api-keys > "Create API Key".
RESEND_API_KEY=
# Where contact messages are delivered. Defaults to kyle@stringhamwebdesign.com.
CONTACT_TO_EMAIL=
# Sender. Must be a resend.com/domains verified domain, or onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# --- The site's own origin ---
# Used for canonical URLs, the sitemap, robots.txt and structured data.
# Public: inlined into the client bundle.
NEXT_PUBLIC_SITE_URL=https://www.stringhamwebdesign.com

# --- Microsoft Clarity (optional: usage analytics and session replay) ---
# clarity.microsoft.com > your project > Settings > "Clarity project id".
# Public; unset means no analytics at all. Set it in Vercel for Production only.
NEXT_PUBLIC_CLARITY_ID=
