# Copy to .env.local (gitignored) and fill in real values. Never commit a
# filled-in copy.

# --- Contact form email (Resend) ---
# With RESEND_API_KEY unset, /api/free-check logs the request on the server and
# still shows the visitor a confirmation, so a missing key never loses a
# lead silently — but nothing is emailed.
# resend.com/api-keys > "Create API Key".
RESEND_API_KEY=
# Where free check requests are delivered. Defaults to kyle@stringhamwebdesign.com.
CONTACT_TO_EMAIL=
# Sender. Must be a resend.com/domains verified domain, or onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# --- The site's own origin ---
# Used for canonical URLs, the sitemap, robots.txt and structured data.
# Public: inlined into the client bundle.
NEXT_PUBLIC_SITE_URL=https://www.stringhamwebdesign.com

# --- Microsoft Clarity (optional: usage analytics and session replay) ---
# clarity.microsoft.com > your project > Settings > "Clarity project id".
# Public; unset means no analytics at all. Set it in Vercel for Production only.
NEXT_PUBLIC_CLARITY_ID=

# --- Booking link for the free 30-minute call (optional) ---
# Calendly, Cal.com, Google appointment page, etc. Public. Unset means no
# booking buttons render (only the hub page uses it).
NEXT_PUBLIC_BOOKING_URL=

# ---- Leads and referral partners (/manage, /partners/join) ----
# Supabase project URL (bare, no /rest/v1) and its secret key (sb_secret_…).
# Server only; never prefix with NEXT_PUBLIC_. Run the two files in
# supabase/migrations (20261014 referrals, 20261024 leads) once each in the
# SQL editor. Unset, forms still email; nothing is saved and /manage says so.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The admin password for /manage (8+ characters). Changing it signs out every session.
ADMIN_PASSWORD=

# ---- "Explain my leads" at /manage (optional) ----
# An Anthropic API key (console.anthropic.com → API keys). Server only. On a
# button press, the admin sends aggregate counts (never names, contacts or
# notes) to the cheapest current model for a short plain-English reading.
# Unset means the button is replaced by a note; the numbers still show.
ANTHROPIC_API_KEY=
